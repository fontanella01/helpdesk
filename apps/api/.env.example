# Required: secret used to sign login tokens (at least 32 random characters)
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# Optional: a real PostgreSQL. Without it, the API uses PGlite and stores data in ./.data
# DATABASE_URL=postgres://user:password@localhost:5432/helpdesk

# Optional: enables the AI assistant. Without it, suggestions run in free demo mode.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# PORT=3333
